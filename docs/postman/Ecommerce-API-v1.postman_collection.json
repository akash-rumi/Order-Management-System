{
  "info": {
    "name": "Ecommerce API - Full Collection (with tests)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Full collection including auth register/logout, product CRUD, variant CRUD, inventory, orders, imports, invoices, search. Use environment variable `base_url` (e.g. http://127.0.0.1:8000/api/v1) and `token` populated by login."
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\":\"Test User\",\n  \"email\":\"user@example.test\",\n  \"password\":\"password\",\n  \"role\":\"customer\"\n}" },
        "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth","register"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Register returns 201', function(){ pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"email\":\"customer1@test.com\",\n  \"password\":\"password\"\n}" },
        "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 or 201', function(){ pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
              "var json = {}; try { json = pm.response.json(); } catch(e) { json = {}; }",
              "pm.test('Access token exists', function(){ pm.expect(json).to.have.property('access_token'); });",
              "if (json.access_token) { pm.environment.set('token', json.access_token); }",
              "pm.test('Saved token to {{token}}', function(){ pm.expect(pm.environment.get('token')).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth","logout"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Logout returns 200', function(){ pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Refresh",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth","refresh"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Refresh returns 200', function(){ pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Products",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/products?per_page=10", "host": ["{{base_url}}"], "path": ["products"], "query":[{"key":"per_page","value":"10"}] }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('Status 200', function(){ pm.response.to.have.status(200); });", "var json = pm.response.json(); pm.test('Has data or array', function(){ pm.expect(json).to.satisfy(v => Array.isArray(v.data) || Array.isArray(v)); });" ] } }
      ]
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\":\"Test Product API\",\n  \"slug\":\"test-product-api\",\n  \"description\":\"desc\",\n  \"is_active\":true\n}" },
        "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('Create product returns 201', function(){ pm.response.to.have.status(201); });", "var json = pm.response.json(); var p = json.data || json; if(p.id) pm.environment.set('created_product_id', p.id);" ] } }
      ]
    },
    {
      "name": "Get Product by ID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/products/{{created_product_id}}", "host": ["{{base_url}}"], "path": ["products","{{created_product_id}}"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('Status 200', function(){ pm.response.to.have.status(200); });" ] } }
      ]
    },
