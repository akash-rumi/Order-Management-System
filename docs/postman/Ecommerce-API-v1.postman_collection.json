        "url": { "raw": "{{base_url}}/products/{{created_product_id}}/variants", "host": ["{{base_url}}"], "path": ["products","{{created_product_id}}","variants"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('Variant create returns 201', function(){ pm.response.to.have.status(201); });", "var json = pm.response.json(); var payload = json.data || json; if(payload.id) pm.environment.set('created_variant_id', payload.id);" ] } }
      ]
