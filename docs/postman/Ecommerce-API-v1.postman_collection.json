        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "formdata", "formdata": [ { "key": "file", "type": "file", "src": "" } ] },
        "url": { "raw": "{{base_url}}/products/import", "host": ["{{base_url}}"], "path": ["products","import"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('Import queued returns 202 or 200', function(){ pm.expect(pm.response.code).to.be.oneOf([200,202]); });", "var json = {}; try{ json = pm.response.json(); } catch(e){}; pm.test('import_id exists', function(){ pm.expect(json).to.have.property('import_id'); if(json.import_id) pm.environment.set('last_import_id', json.import_id); });" ] } }
