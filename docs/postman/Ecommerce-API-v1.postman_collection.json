        "body": { "mode": "raw", "raw": "{\n  \"name\":\"Updated Product Name\"\n}" },
        "url": { "raw": "{{base_url}}/products/{{created_product_id}}", "host": ["{{base_url}}"], "path": ["products","{{created_product_id}}"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('Update returns 200 or 204', function(){ pm.expect(pm.response.code).to.be.oneOf([200,204]); });" ] } }
      ]
    },
