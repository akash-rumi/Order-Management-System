        "body": { "mode": "raw", "raw": "{\n  \"items\": [ { \"variant_id\": {{created_variant_id}}, \"quantity\": 1 } ],\n  \"shipping_address\": { \"name\":\"Test\", \"line1\":\"Addr\", \"city\":\"Dhaka\", \"country\":\"Bangladesh\" }\n}" },
        "url": { "raw": "{{base_url}}/orders", "host": ["{{base_url}}"], "path": ["orders"] }
