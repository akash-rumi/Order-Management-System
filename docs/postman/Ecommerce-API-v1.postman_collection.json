        "body": { "mode": "raw", "raw": "{\n  \"delta\":-2,\n  \"reason\":\"reservation\"\n}" },
        "url": { "raw": "{{base_url}}/inventories/{{created_variant_id}}/adjust", "host": ["{{base_url}}"], "path": ["inventories","{{created_variant_id}}","adjust"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('Adjust inventory returns 200', function(){ pm.response.to.have.status(200); });", "var json = pm.response.json(); pm.test('Response has available', function(){ var p = json.data || json; pm.expect(p).to.have.property('available'); });" ] } }
      ]
    },
